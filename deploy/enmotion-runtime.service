[Unit]
Description=Enmotion robot runtime and debug dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lyz
Group=lyz
SupplementaryGroups=dialout
WorkingDirectory=/home/lyz/enmotion_robot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ENMOTION_DIALOGUE_URL=http://127.0.0.1:8081/v1/chat/completions
Environment=ENMOTION_DIALOGUE_MODEL=qwen3-4b-q4
Environment=ENMOTION_DIALOGUE_TIMEOUT=45
ExecStart=/home/lyz/enmotion_robot/.venv/bin/enmotion-runtime --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

